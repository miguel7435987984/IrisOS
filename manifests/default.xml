<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Remote oficial LineageOS -->
  <remote name="lineage"
          fetch="https://github.com/LineageOS"
          review="review.lineageos.org"
          revision="refs/heads/lineage-21.0" />

  <!-- Remote para repositórios oficiais AOSP -->
  <remote name="aosp"
          fetch="https://android.googlesource.com"
          review="android-review.googlesource.com"
          revision="refs/tags/android-14.0.0_r50" />

  <!-- Remote do projeto IrisOS -->
  <remote name="iris"
          fetch="https://github.com/miguel7435987984"
          revision="main" />

  <default revision="refs/heads/lineage-21.0"
           remote="lineage"
           sync-j="4" />

  <!-- Importa o manifesto base oficial do LineageOS 21.0 -->
  <include name="snippets/lineage.xml" />
</manifest>
