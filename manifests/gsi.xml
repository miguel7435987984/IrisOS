          fetch="https://github.com/phhusson"
          revision="android-14.0" />

  <remote name="andyyan"
          fetch="https://github.com/AndyCGYan"
          revision="lineage-21_td" />

  <!-- Device tree genérico Treble para compilar system.img (ARM64 A/B) -->
